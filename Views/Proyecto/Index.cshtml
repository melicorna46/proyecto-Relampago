@model IEnumerable<ScrumMvp.Models.ProyectoConEquipoViewModel>
@using System.Linq
@{
    ViewBag.Title = "Mis proyectos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1" style="color:#16224E; font-weight:700;">Mis proyectos</h1>
        <p class="text-muted mb-0">Elegí un proyecto o creá uno nuevo para empezar.</p>
    </div>
    <a href="@Url.Action("Crear", "Proyecto")" class="btn btn-brand">+ Nuevo proyecto</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="empty-state">
        <h5 class="mb-2">Todavía no tenés proyectos</h5>
        <p class="mb-3">Creá tu primer proyecto para armar el equipo y el Product Backlog.</p>
        <a href="@Url.Action("Crear", "Proyecto")" class="btn btn-brand">Crear mi primer proyecto</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title" style="color:#16224E; font-weight:700;">@item.Proyecto.Nombre</h5>
                        <p class="card-text text-muted small flex-grow-1">@item.Proyecto.ProductGoal</p>

                        <div class="d-flex gap-2 mt-2">
                            @if (item.EquipoId.HasValue)
                            {
                                <a href="@Url.Action("Index", "Equipo", new { equipoId = item.EquipoId })" class="btn btn-outline-brand btn-sm">
                                    Ver equipo
                                </a>
                            }
                            else
                            {
                                <a href="@Url.Action("Crear", "Equipo", new { proyectoId = item.Proyecto.Id })" class="btn btn-outline-brand btn-sm">
                                    Crear equipo
                                </a>
                            }

                            <a href="@Url.Action("Index", "Backlog", new { proyectoId = item.Proyecto.Id })" class="btn btn-brand btn-sm">
                                Ver Backlog
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

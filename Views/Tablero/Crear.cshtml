@model ScrumMvp.Models.TareaViewModel
@{
    ViewBag.Title = "Nueva tarea";
    var historia = (ScrumMvp.Models.Historia)ViewBag.Historia;
    int sprintId = (int)ViewBag.SprintId;
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <p class="text-muted mb-1 small">
            Historia: <code>@historia.Codigo</code> <strong>@historia.Titulo</strong>
        </p>
        <div class="card shadow-sm">
            <div class="card-body p-4 p-md-5">
                <h1 class="h4 mb-4" style="color:#16224E; font-weight:700;">Nueva tarea técnica</h1>

                @using (Html.BeginForm("Crear", "Tablero", new { sprintId }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.HistoriaId)
                    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Titulo)
                        @Html.TextBoxFor(m => m.Titulo, new { @class = "form-control", placeholder = "Ej: Endpoint POST /registro", autofocus = "autofocus" })
                        @Html.ValidationMessageFor(m => m.Titulo, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Descripcion)
                        @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 3 })
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(m => m.HorasEstimadas)
                        @Html.TextBoxFor(m => m.HorasEstimadas, new { @class = "form-control", type = "number", step = "0.5", min = "0" })
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-brand">Crear tarea</button>
                        <a href="@Url.Action("Index", "Tablero", new { sprintId })" class="btn btn-outline-brand">Cancelar</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

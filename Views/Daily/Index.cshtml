@model IEnumerable<ScrumMvp.Models.DailyConUsuario>
@using System.Linq
@{
    ViewBag.Title = "Daily Scrum";
    var sprint = (ScrumMvp.Models.Sprint)ViewBag.Sprint;
    var miDaily = (ScrumMvp.Models.Daily)ViewBag.MiDailyDeHoy;
}

<p class="text-muted mb-1 small">Proyecto: <strong>@ViewBag.NombreProyecto</strong></p>
<h1 class="h3 mb-1" style="color:#16224E; font-weight:700;">Daily Scrum — @sprint.Nombre</h1>
<p class="text-muted mb-4">
    <a href="@Url.Action("Index", "Sprint", new { proyectoId = sprint.ProyectoId })" class="text-decoration-none">
        ← Volver al Sprint
    </a>
</p>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-4">
    <a href="@Url.Action("Registrar", "Daily", new { sprintId = sprint.Id })" class="btn btn-brand btn-sm">
        @(miDaily == null ? "Registrar mi Daily de hoy" : "Editar mi Daily de hoy")
    </a>
</div>

<h2 class="h5 mb-3" style="color:#16224E;">Daily de hoy — todo el equipo</h2>

@if (!Model.Any())
{
    <div class="empty-state">
        <h5 class="mb-2">Todavía nadie registró su Daily de hoy</h5>
        <p class="mb-0">Sé el primero en contar qué avanzaste y qué vas a hacer.</p>
    </div>
}
else
{
    <div class="d-flex flex-column gap-2">
        @foreach (var d in Model)
        {
            <div class="card shadow-sm">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-semibold" style="color:#16224E;">@d.UsuarioNombre</span>
                        @if (d.TieneImpedimento)
                        {
                            <span class="badge text-bg-danger rounded-pill px-3 py-2">Impedimento</span>
                        }
                    </div>
                    <p class="text-muted small mb-1"><strong>Qué avancé:</strong> @d.QueAvance</p>
                    <p class="text-muted small mb-0"><strong>Qué haré:</strong> @d.QueHare</p>
                    @if (d.TieneImpedimento)
                    {
                        <p class="text-danger small mb-0 mt-1"><strong>Impedimento:</strong> @d.ImpedimentoTexto</p>
                    }
                </div>
            </div>
        }
    </div>
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Scrum MVP</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --azul-marca: #2952E3;
            --azul-oscuro: #16224E;
            --azul-suave: #EEF2FF;
            --gris-fondo: #F7F8FB;
            --gris-borde: #E5E8F0;
            --gris-texto: #6B7280;
        }

        * {
            font-family: 'Inter', sans-serif;
        }

        body {
            background: var(--gris-fondo);
        }

        .navbar-app {
            background: #fff;
            border-bottom: 1px solid var(--gris-borde);
            padding: .85rem 0;
        }

            .navbar-app .navbar-brand {
                font-weight: 800;
                color: var(--azul-oscuro);
            }

                .navbar-app .navbar-brand span {
                    color: var(--azul-marca);
                }

            .navbar-app .nav-link {
                color: #4B5563;
                font-weight: 500;
            }

                .navbar-app .nav-link.active, .navbar-app .nav-link:hover {
                    color: var(--azul-marca);
                }

        .user-chip {
            background: var(--azul-suave);
            color: var(--azul-marca);
            font-weight: 600;
            border-radius: 999px;
            padding: .4rem .9rem;
            font-size: .85rem;
        }

        .card {
            border: 1px solid var(--gris-borde);
            border-radius: 14px;
        }

        .form-label {
            font-weight: 600;
            color: #374151;
            font-size: .88rem;
        }

        .form-control, .form-select {
            border-radius: 10px;
            border: 1px solid var(--gris-borde);
            padding: .6rem .85rem;
            font-size: .95rem;
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--azul-marca);
                box-shadow: 0 0 0 .2rem rgba(41,82,227,.12);
            }

        .btn-brand {
            background: var(--azul-marca);
            border: none;
            color: #fff;
            font-weight: 600;
            border-radius: 10px;
            padding: .6rem 1.1rem;
        }

            .btn-brand:hover {
                background: #1F3FC2;
                color: #fff;
            }

        .btn-outline-brand {
            border: 1px solid var(--azul-marca);
            color: var(--azul-marca);
            border-radius: 10px;
            font-weight: 600;
            padding: .55rem 1.1rem;
            background: #fff;
        }

            .btn-outline-brand:hover {
                background: var(--azul-suave);
                color: var(--azul-marca);
            }

        .validation-summary-valid, .field-validation-valid {
            display: none;
        }

        .empty-state {
            border: 1.5px dashed var(--gris-borde);
            border-radius: 14px;
            padding: 3rem 1.5rem;
            text-align: center;
            color: var(--gris-texto);
            background: #fff;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-app">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Proyecto")">Scrum<span>MVP</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navApp">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navApp">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Proyecto")">Proyectos</a></li>
                </ul>
                @if (Session["UsuarioActual"] != null)
                {
                    var usuario = (ScrumMvp.Models.UsuarioSesion)Session["UsuarioActual"];
                    <div class="d-flex align-items-center gap-3">
                        <span class="user-chip">@usuario.Nombre</span>
                        <a class="nav-link" href="@Url.Action("Logout", "Cuenta")">Salir</a>
                    </div>
                }
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>

@model ScrumMvp.Models.RegistroViewModel
@{
    ViewBag.Title = "Registro de usuario";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3 text-center">Crear cuenta</h1>

                @using (Html.BeginForm("Registro", "Cuenta", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Nombre, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Especialidad, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Especialidad, new { @class = "form-control", placeholder = "Ej: Developer, Scrum Master..." })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(m => m.ConfirmarPassword, new { @class = "form-label" })
                        @Html.PasswordFor(m => m.ConfirmarPassword, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.ConfirmarPassword, "", new { @class = "text-danger small" })
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Crear cuenta</button>
                }

                <p class="text-center small text-muted mt-3 mb-0">
                    ¿Ya tenés cuenta? <a href="@Url.Action("Login", "Cuenta")">Iniciá sesión</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

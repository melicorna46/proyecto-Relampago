@model ScrumMvp.Models.RegistroViewModel
@{
    ViewBag.Title = "Crear cuenta";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<h2>Creá tu cuenta</h2>
<p class="subtitle mb-4">Sumate a tu equipo Scrum en un par de minutos.</p>

@using (Html.BeginForm("Registro", "Cuenta", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger py-2" })

    <div class="mb-3">
        @Html.LabelFor(m => m.Nombre, "Nombre completo")
        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Ej: Ana Rojas", autofocus = "autofocus" })
        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger small" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Email, "Correo electrónico")
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "nombre@empresa.com" })
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Especialidad, "Rol en el equipo")
        @Html.DropDownListFor(
            m => m.Especialidad,
            (SelectList)ViewBag.Roles,
            "Seleccioná un rol...",
            new { @class = "form-select" }
        )
        @Html.ValidationMessageFor(m => m.Especialidad, "", new { @class = "text-danger small" })
    </div>

    <div class="row">
        <div class="col-6 mb-3">
            @Html.LabelFor(m => m.Password, "Contraseña")
            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Mín. 8 caracteres" })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
        </div>
        <div class="col-6 mb-3">
            @Html.LabelFor(m => m.ConfirmarPassword, "Confirmar")
            @Html.PasswordFor(m => m.ConfirmarPassword, new { @class = "form-control", placeholder = "Repetí la contraseña" })
            @Html.ValidationMessageFor(m => m.ConfirmarPassword, "", new { @class = "text-danger small" })
        </div>
    </div>

    <button type="submit" class="btn btn-brand w-100 mt-2 mb-3">Crear cuenta</button>
}

<p class="text-center small text-muted mb-0">
    ¿Ya tenés cuenta? <a class="auth-alt-link" href="@Url.Action("Login", "Cuenta")">Iniciá sesión</a>
</p>

@model IEnumerable<ScrumMvp.Models.Historia>
@using System.Linq
@{
    ViewBag.Title = "Planificar Sprint";
    var sprint = (ScrumMvp.Models.Sprint)ViewBag.Sprint;
}

<p class="text-muted mb-1 small">Proyecto: <strong>@ViewBag.NombreProyecto</strong></p>
<h1 class="h3 mb-1" style="color:#16224E; font-weight:700;">Planificar @sprint.Nombre</h1>
<p class="text-muted mb-4">Sprint Goal: <strong>@sprint.SprintGoal</strong></p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="empty-state">
        <h5 class="mb-2">No hay historias en el Product Backlog</h5>
        <p class="mb-0">Pedile al Product Owner que cargue historias antes de planificar.</p>
    </div>
}
else
{
    using (Html.BeginForm("Planificar", "Sprint", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("sprintId", sprint.Id)

        <div class="d-flex flex-column gap-2 mb-4">
            @foreach (var h in Model)
            {
                <label class="card shadow-sm p-3 d-flex flex-row align-items-center gap-3" style="cursor:pointer;">
                    <input type="checkbox" name="historiaIds" value="@h.Id" class="form-check-input mt-0" style="width:1.2em;height:1.2em;" />
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <code class="text-muted">@h.Codigo</code>
                            <span class="fw-semibold" style="color:#16224E;">@h.Titulo</span>
                        </div>
                        <p class="text-muted small mb-0">Como <strong>@h.RolComo</strong>, quiero @h.NecesidadQuiero</p>
                    </div>
                    <span class="badge @ScrumMvp.Helpers.PrioridadHelper.ClaseBadge(h.Prioridad) rounded-pill px-3 py-2">
                        @ScrumMvp.Helpers.PrioridadHelper.Etiqueta(h.Prioridad)
                    </span>
                    @if (h.StoryPoints.HasValue)
                    {
                        <span class="badge text-bg-light text-dark border">@h.StoryPoints pts</span>
                    }
                </label>
            }
        </div>

        <button type="submit" class="btn btn-brand">Agregar al Sprint Backlog</button>
    }
}
